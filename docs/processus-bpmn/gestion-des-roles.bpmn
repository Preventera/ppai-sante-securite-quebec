  <!-- P6 — Gestion des rôles — © 2026 Preventera / AgenticX5. Généré par scripts/bpmn/generer_bpmn.py -->
  <bpmn:collaboration id="collab_gestion-des-roles">
    <bpmn:participant id="pool_gestion-des-roles" name="P6 — Gestion des rôles" processRef="proc_gestion-des-roles" />
  </bpmn:collaboration>
  <bpmn:process id="proc_gestion-des-roles" isExecutable="false">
    <bpmn:laneSet id="laneset_gestion-des-roles">
      <bpmn:lane id="lane_gestion-des-roles_0" name="Direction (admin)">
        <bpmn:flowNodeRef>p6_debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_ouvrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_choisir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_fin_refus</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_gestion-des-roles_1" name="Application PPAI">
        <bpmn:flowNodeRef>p6_garde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_refus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_effet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_gestion-des-roles_2" name="Base de données (RLS)">
        <bpmn:flowNodeRef>p6_lister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_soi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_bloque</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_appliquer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p6_debut" name="Collègue à habiliter">
      <bpmn:outgoing>flow_gestion-des-roles_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p6_ouvrir" name="Ouvrir « Utilisateurs »">
      <bpmn:incoming>flow_gestion-des-roles_0</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p6_garde" name="Rôle administrateur ?">
      <bpmn:incoming>flow_gestion-des-roles_1</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_2</bpmn:outgoing>
      <bpmn:outgoing>flow_gestion-des-roles_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p6_refus" name="Expliquer le refus (pas de redirection muette)">
      <bpmn:incoming>flow_gestion-des-roles_2</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p6_lister" name="Lister les profils de l&#x27;organisation">
      <bpmn:incoming>flow_gestion-des-roles_4</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p6_choisir" name="Attribuer un rôle">
      <bpmn:incoming>flow_gestion-des-roles_5</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p6_soi" name="Son propre profil ?">
      <bpmn:incoming>flow_gestion-des-roles_6</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_7</bpmn:outgoing>
      <bpmn:outgoing>flow_gestion-des-roles_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p6_bloque" name="Refuser : une organisation garde son administrateur">
      <bpmn:incoming>flow_gestion-des-roles_7</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p6_appliquer" name="Appliquer le rôle">
      <bpmn:incoming>flow_gestion-des-roles_9</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p6_effet" name="Recomposer la navigation et les droits d&#x27;écriture">
      <bpmn:incoming>flow_gestion-des-roles_10</bpmn:incoming>
      <bpmn:outgoing>flow_gestion-des-roles_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p6_fin" name="Habilitation effective">
      <bpmn:incoming>flow_gestion-des-roles_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="p6_fin_refus" name="Accès refusé, motif affiché">
      <bpmn:incoming>flow_gestion-des-roles_3</bpmn:incoming>
      <bpmn:incoming>flow_gestion-des-roles_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_gestion-des-roles_0" sourceRef="p6_debut" targetRef="p6_ouvrir" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_1" sourceRef="p6_ouvrir" targetRef="p6_garde" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_2" sourceRef="p6_garde" targetRef="p6_refus" name="non" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_3" sourceRef="p6_refus" targetRef="p6_fin_refus" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_4" sourceRef="p6_garde" targetRef="p6_lister" name="oui" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_5" sourceRef="p6_lister" targetRef="p6_choisir" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_6" sourceRef="p6_choisir" targetRef="p6_soi" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_7" sourceRef="p6_soi" targetRef="p6_bloque" name="oui" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_8" sourceRef="p6_bloque" targetRef="p6_fin_refus" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_9" sourceRef="p6_soi" targetRef="p6_appliquer" name="non" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_10" sourceRef="p6_appliquer" targetRef="p6_effet" />
    <bpmn:sequenceFlow id="flow_gestion-des-roles_11" sourceRef="p6_effet" targetRef="p6_fin" />
  </bpmn:process>

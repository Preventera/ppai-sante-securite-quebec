                  id="defs_assujettissement-reglementaire" targetNamespace="http://agenticx5.com/ppai/bpmn">
  <!-- P2 — Assujettissement réglementaire — © 2026 Preventera / AgenticX5. Généré par scripts/bpmn/generer_bpmn.py -->
  <bpmn:collaboration id="collab_assujettissement-reglementaire">
    <bpmn:participant id="pool_assujettissement-reglementaire" name="P2 — Assujettissement réglementaire" processRef="proc_assujettissement-reglementaire" />
  </bpmn:collaboration>
  <bpmn:process id="proc_assujettissement-reglementaire" isExecutable="false">
    <bpmn:laneSet id="laneset_assujettissement-reglementaire">
      <bpmn:lane id="lane_assujettissement-reglementaire_0" name="Direction / Responsable SST">
        <bpmn:flowNodeRef>p2_debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_saisir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_assujettissement-reglementaire_1" name="Application PPAI">
        <bpmn:flowNodeRef>p2_calcul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_seuil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_programme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_menu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_assujettissement-reglementaire_2" name="Référentiel CNESST">
        <bpmn:flowNodeRef>p2_niveau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_modalites</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_debut" name="Établissement à qualifier">
      <bpmn:outgoing>flow_assujettissement-reglementaire_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p2_saisir" name="Déclarer l&#x27;effectif et le sous-secteur SCIAN">
      <bpmn:incoming>flow_assujettissement-reglementaire_0</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p2_niveau" name="Résoudre le niveau (annexe I, 102 sous-secteurs)">
      <bpmn:incoming>flow_assujettissement-reglementaire_1</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_calcul" name="determinerMecanismes()">
      <bpmn:incoming>flow_assujettissement-reglementaire_2</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_seuil" name="20 travailleurs ou plus ?">
      <bpmn:incoming>flow_assujettissement-reglementaire_3</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_4</bpmn:outgoing>
      <bpmn:outgoing>flow_assujettissement-reglementaire_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p2_programme" name="Programme de prévention + comité + représentant">
      <bpmn:incoming>flow_assujettissement-reglementaire_4</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_modalites" name="Composition (art. 7) Réunions (art. 19) Libération (art. 33)">
      <bpmn:incoming>flow_assujettissement-reglementaire_5</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_plan" name="Plan d&#x27;action + agent de liaison">
      <bpmn:incoming>flow_assujettissement-reglementaire_7</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p2_menu" name="Renommer l&#x27;entrée de menu selon le mécanisme retenu">
      <bpmn:incoming>flow_assujettissement-reglementaire_6</bpmn:incoming>
      <bpmn:incoming>flow_assujettissement-reglementaire_8</bpmn:incoming>
      <bpmn:outgoing>flow_assujettissement-reglementaire_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p2_fin" name="Obligations connues">
      <bpmn:incoming>flow_assujettissement-reglementaire_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_0" sourceRef="p2_debut" targetRef="p2_saisir" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_1" sourceRef="p2_saisir" targetRef="p2_niveau" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_2" sourceRef="p2_niveau" targetRef="p2_calcul" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_3" sourceRef="p2_calcul" targetRef="p2_seuil" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_4" sourceRef="p2_seuil" targetRef="p2_programme" name="oui" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_5" sourceRef="p2_programme" targetRef="p2_modalites" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_6" sourceRef="p2_modalites" targetRef="p2_menu" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_7" sourceRef="p2_seuil" targetRef="p2_plan" name="non" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_8" sourceRef="p2_plan" targetRef="p2_menu" />
    <bpmn:sequenceFlow id="flow_assujettissement-reglementaire_9" sourceRef="p2_menu" targetRef="p2_fin" />
  </bpmn:process>

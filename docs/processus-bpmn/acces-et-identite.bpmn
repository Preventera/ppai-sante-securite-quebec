        <bpmn:flowNodeRef>p1_courriel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_lien</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_debut" name="Besoin d&#x27;accès">
      <bpmn:outgoing>flow_acces-et-identite_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="p1_choix" name="Compte existant ?">
      <bpmn:incoming>flow_acces-et-identite_0</bpmn:incoming>
      <bpmn:outgoing>flow_acces-et-identite_1</bpmn:outgoing>
      <bpmn:outgoing>flow_acces-et-identite_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_inscrire" name="Saisir courriel, mot de passe et nom de l&#x27;entreprise">

        <bpmn:flowNodeRef>p1_signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_demande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_session</bpmn:flowNodeRef>
      </bpmn:lane>

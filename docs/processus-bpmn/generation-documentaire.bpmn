      <bpmn:outgoing>flow_generation-documentaire_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p5_backend" name="Backend joignable ?">
      <bpmn:incoming>flow_generation-documentaire_2</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_3</bpmn:outgoing>
      <bpmn:outgoing>flow_generation-documentaire_8</bpmn:outgoing>

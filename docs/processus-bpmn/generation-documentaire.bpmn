  </bpmn:collaboration>
  <bpmn:process id="proc_generation-documentaire" isExecutable="false">
    <bpmn:laneSet id="laneset_generation-documentaire">
      <bpmn:lane id="lane_generation-documentaire_0" name="Responsable SST">
        <bpmn:flowNodeRef>p5_debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_generation-documentaire_1" name="Application PPAI">
        <bpmn:flowNodeRef>p5_contexte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_backend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_echec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_local</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_provenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_conserver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_generation-documentaire_2" name="Edge Function (Claude)">
        <bpmn:flowNodeRef>p5_claude</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_generation-documentaire_3" name="Journal d&#x27;exécution">
        <bpmn:flowNodeRef>p5_consigner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_journal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p5_debut" name="Document à produire">
      <bpmn:outgoing>flow_generation-documentaire_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p5_type" name="Choisir le type de document (langage métier)">
      <bpmn:incoming>flow_generation-documentaire_0</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p5_contexte" name="Assembler le contexte : registre + mécanismes exigés">

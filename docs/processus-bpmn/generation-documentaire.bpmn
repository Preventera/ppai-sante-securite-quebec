    </bpmn:serviceTask>
    <bpmn:serviceTask id="p5_local" name="Générer localement (déterministe)">
      <bpmn:incoming>flow_generation-documentaire_7</bpmn:incoming>
      <bpmn:incoming>flow_generation-documentaire_8</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p5_provenance" name="Figer la provenance + empreinte du registre">
      <bpmn:incoming>flow_generation-documentaire_5</bpmn:incoming>
      <bpmn:incoming>flow_generation-documentaire_9</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p5_journal" name="Journaliser durée, moteur, jetons — jamais le document">
      <bpmn:incoming>flow_generation-documentaire_10</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p5_conserver" name="Conserver le programme">
      <bpmn:incoming>flow_generation-documentaire_11</bpmn:incoming>
      <bpmn:outgoing>flow_generation-documentaire_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="p5_fin" name="Document traçable">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="defs_signalement-terrain" targetNamespace="http://agenticx5.com/ppai/bpmn">
  <!-- P4 — Signalement terrain et qualification — © 2026 Preventera / AgenticX5. Généré par scripts/bpmn/generer_bpmn.py -->
  <bpmn:collaboration id="collab_signalement-terrain">
    <bpmn:participant id="pool_signalement-terrain" name="P4 — Signalement terrain et qualification" processRef="proc_signalement-terrain" />
  </bpmn:collaboration>
  <bpmn:process id="proc_signalement-terrain" isExecutable="false">
    <bpmn:laneSet id="laneset_signalement-terrain">
      <bpmn:lane id="lane_signalement-terrain_0" name="Travailleur">
        <bpmn:flowNodeRef>p4_debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_decrire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_suite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_signalement-terrain_1" name="Responsable SST">
        <bpmn:flowNodeRef>p4_examiner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_qualifier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_note</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_signalement-terrain_2" name="Base de données (RLS)">
        <bpmn:flowNodeRef>p4_imposer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_creer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_statuer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p4_debut" name="Situation dangereuse observée">
      <bpmn:outgoing>flow_signalement-terrain_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p4_decrire" name="Décrire et situer (téléphone, 2 champs)">
      <bpmn:incoming>flow_signalement-terrain_0</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p4_imposer" name="Imposer auteur et organisation depuis la session">
      <bpmn:incoming>flow_signalement-terrain_1</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="p4_file" name="Déposer dans la file statut « nouveau »">
      <bpmn:incoming>flow_signalement-terrain_2</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p4_examiner" name="Examiner le signalement">
      <bpmn:incoming>flow_signalement-terrain_3</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p4_decision" name="Devient un risque ?">
      <bpmn:incoming>flow_signalement-terrain_4</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_5</bpmn:outgoing>
      <bpmn:outgoing>flow_signalement-terrain_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p4_qualifier" name="Coter et compléter (formulaire prérempli)">
      <bpmn:incoming>flow_signalement-terrain_5</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p4_creer" name="Créer le risque au registre">
      <bpmn:incoming>flow_signalement-terrain_6</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="p4_note" name="Rédiger la note d&#x27;écartement (obligatoire)">
      <bpmn:incoming>flow_signalement-terrain_8</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="p4_statuer" name="Consigner la décision">
      <bpmn:incoming>flow_signalement-terrain_7</bpmn:incoming>
      <bpmn:incoming>flow_signalement-terrain_9</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="p4_suite" name="Consulter la suite donnée">
      <bpmn:incoming>flow_signalement-terrain_10</bpmn:incoming>
      <bpmn:outgoing>flow_signalement-terrain_11</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="p4_fin" name="Signalement traité">
      <bpmn:incoming>flow_signalement-terrain_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_signalement-terrain_0" sourceRef="p4_debut" targetRef="p4_decrire" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_1" sourceRef="p4_decrire" targetRef="p4_imposer" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_2" sourceRef="p4_imposer" targetRef="p4_file" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_3" sourceRef="p4_file" targetRef="p4_examiner" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_4" sourceRef="p4_examiner" targetRef="p4_decision" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_5" sourceRef="p4_decision" targetRef="p4_qualifier" name="oui" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_6" sourceRef="p4_qualifier" targetRef="p4_creer" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_7" sourceRef="p4_creer" targetRef="p4_statuer" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_8" sourceRef="p4_decision" targetRef="p4_note" name="non" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_9" sourceRef="p4_note" targetRef="p4_statuer" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_10" sourceRef="p4_statuer" targetRef="p4_suite" />
    <bpmn:sequenceFlow id="flow_signalement-terrain_11" sourceRef="p4_suite" targetRef="p4_fin" />
  </bpmn:process>

      </bpmn:lane>
      <bpmn:lane id="lane_constitution-du-registre_1" name="Application PPAI">
        <bpmn:flowNodeRef>p3_plurivoque</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3_vide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3_avertir</bpmn:flowNodeRef>

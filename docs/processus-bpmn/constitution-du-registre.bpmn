      </bpmn:lane>
      <bpmn:lane id="lane_constitution-du-registre_2" name="Référentiel CNESST">
        <bpmn:flowNodeRef>p3_charger</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p3_debut" name="Registre à constituer">
      <bpmn:outgoing>flow_constitution-du-registre_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p3_ouvrir" name="Ouvrir « Proposer les risques de mon secteur »">
      <bpmn:incoming>flow_constitution-du-registre_0</bpmn:incoming>
      <bpmn:outgoing>flow_constitution-du-registre_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p3_secteur" name="Choisir le sous-secteur SCIAN">
      <bpmn:incoming>flow_constitution-du-registre_1</bpmn:incoming>

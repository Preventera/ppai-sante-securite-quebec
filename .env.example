# ==========================================
# PPAI — Variables d'environnement
#
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# AUCUNE variable n'est obligatoire : sans configuration, l'application
# démarre en mode démonstration autonome (données persistées dans le
# navigateur, génération de programme par le moteur local).
# ==========================================

# --- Supabase (mode « live ») ---------------------------------------------
# Tableau de bord Supabase > Project Settings > API
# Si ces variables sont absentes, le projet de repli défini dans src/lib/env.ts
# est utilisé ; s'il est injoignable ou si le schéma manque, l'application
# bascule automatiquement en mode démonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Mode démonstration forcé ---------------------------------------------
# `true` force la persistance locale et le générateur local, même si Supabase
# est joignable. Utile pour une démonstration hors ligne et déterministe.
VITE_DEMO_MODE=

# --- Métadonnées applicatives ---------------------------------------------
VITE_APP_ENV=development
VITE_VERSION=

# ==========================================
# Secrets côté serveur (Edge Functions Supabase)
#
# Ne PAS mettre ces valeurs ici ni dans une variable VITE_* : tout ce qui est
# préfixé VITE_ est exposé publiquement dans le bundle JavaScript.
# Les définir avec : supabase secrets set ANTHROPIC_API_KEY=...
# ==========================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5   # facultatif, surcharge le modèle par défaut
